# 技能推荐链路 · 配置模板
#
# 用法：复制成 .env 再填真实值。.env 已被 gitignore，不会入库。
#     cp .env.example .env
#
# 优先级：真实环境变量 > .env > 代码默认值
# 所以临时覆盖可以直接在命令前加，不必改文件：
#     OPENAI_API_KEY=xxx python run_recall.py --dense

# ---------------------------------------------------------------------------
# 稠密向量召回（可选）
#
# 留空 OPENAI_API_KEY 时这一路静默缺席，链路自动退化为纯 BM25。
# 只需要一个 OpenAI 兼容的 embedding 端点，不需要装任何 SDK。
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# 硅基流动（新用户有免费额度）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# 本地 Ollama —— 完全免费、无额度限制、数据不出机器
#     ollama pull bge-m3
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# EMBED_MODEL=bge-m3

# OpenAI 官方（留空 OPENAI_BASE_URL 即默认）
# OPENAI_BASE_URL=
# EMBED_MODEL=text-embedding-3-small

# embedding 请求超时（秒）
# EMBED_TIMEOUT=60

# ---------------------------------------------------------------------------
# 召回参数
#
# 两路名额刻意不对称：BM25 只认词面，跨语言时命中的多是同语言里的弱相关项，
# 给它更少名额是在限制它的影响面。最终候选池大小的上界 = SPARSE_K + DENSE_K。
# ---------------------------------------------------------------------------
# BM25 一路召回条数
# SPARSE_K=10

# 稠密一路召回条数
# DENSE_K=40

# 技能库规模不超过此值时跳过检索，全量进下一层
# SMALL_N=60

# 开启稠密通路的开关（命令行 --dense 等价）
# USE_EMBED=1

# ---------------------------------------------------------------------------
# 第 2 层 · 精排（TypeSafe System One 协议）
#
# 兼容该协议的服务都能接，换供应商只改 JUDGE_BASE_URL。
# 不配 key 时精排缺席，链路退回本地模拟器（仅能验证链路通不通）。
# ---------------------------------------------------------------------------
JUDGE_API_KEY=

# 阿里云百炼 · decision-model-preview（限时免费，国内直连）
#   控制台右上角 → 业务空间管理 → 复制 Workspace ID（形如 ws_xxxxxxxxxxxx）
# JUDGE_BASE_URL=https://{workspace}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# JUDGE_MODEL=decision-model-preview

# TypeSafe 官方 Jev
# JUDGE_BASE_URL=https://api.typesafe.ai/v1
# JUDGE_MODEL=jev-latest

# 本地 Ollama（0.35+）
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=nimble
# JUDGE_API_KEY=ollama

# 单次请求最多挂几个问题。官方建议 ≤16，延迟随问题数近线性增长；
# 候选多于这个数会被分批并发，而不是拆成多次串行。
# JUDGE_BATCH=16

# ---------------------------------------------------------------------------
# 第 3 层 · 决策
#
# 这两个是**链路参数**，由评测标定后写在这里 —— 服务端独占，接口不接受客户端覆盖。
# 阈值必须自己标定：不同模型的概率分布差别很大。实测 decision-model-preview 给
# 45 条候选的最低分都在 0.02 以上、正解在 0.9 量级，照抄 0.35 等于永不拒答。
#
# 标定方式：
#     python run_eval.py --eval data/eval.jsonl --sweep 0.3,0.4,0.5,0.6
# ---------------------------------------------------------------------------
# 最终推荐条数
TOP_K=3

# 拒答阈值：精排概率低于它的候选被丢弃；全部被丢弃则输出「拒答」而非硬凑
MIN_SCORE=0.4

# ---------------------------------------------------------------------------
# 技能库位置
# ---------------------------------------------------------------------------
# --skills 的默认值
# SKILLS_DIR=data/skills
